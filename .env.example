SUPABASE_DB_URL=
# Per-role login connections (T3-m1-data-core §2.5); local dev uses the
# constants the roles migration creates. Rotate for any non-local instance.
ORCHESTRATOR_DB_URL=
PAYLOAD_READER_DB_URL=
